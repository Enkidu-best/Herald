#!/bin/bash
# Запускает окно Herald из окружения проекта.
# .app лежит внутри папки программы, поэтому корень — три уровня вверх от MacOS/.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../../.." && pwd)"
cd "$ROOT" || exit 1

PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  osascript -e 'display alert "Herald" message "Окружение не найдено. Запусти setup_mac.command в папке программы." as critical'
  exit 1
fi

# Интерпретатор зовём напрямую: при запуске из .app окружение урезанное, и
# после source .venv/bin/activate команда python всё равно не находится.
export PYTHONHASHSEED=0          # должен быть числом, иначе падают дочерние процессы
export PYTORCH_ENABLE_MPS_FALLBACK=1
export PATH="$ROOT/.venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

LOG="$HOME/Library/Logs/Herald.log"
mkdir -p "$(dirname "$LOG")"

# arch -arm64 обязателен. И /bin/bash, и системный python — универсальные
# бинарники; запущенный из Finder .app может уехать в ветку x86_64 (Rosetta),
# а собранные под arm64 numpy/mlx тогда не загружаются:
#   «mach-o file, but is an incompatible architecture (have 'arm64', need 'x86_64')»
# Из терминала этого не видно — там архитектура уже правильная.
if [ "$(uname -m)" = "arm64" ] && command -v arch >/dev/null; then
  exec arch -arm64 "$PY" tts_gui.py >>"$LOG" 2>&1
fi
exec "$PY" tts_gui.py >>"$LOG" 2>&1
